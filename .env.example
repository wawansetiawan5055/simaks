# .env.example for SIMAKS
# Copy to .env or .env.local and adjust values for your environment.

# Main application database
DB_HOST=localhost
DB_NAME=db_simaks
DB_USER=administrator
DB_PASS=your_password_here

# Optional: enable CBT module (true/false)
ENABLE_CBT=false
# If CBT is enabled, you can specify a separate database
CBT_DB_HOST=localhost
CBT_DB_NAME=db_cbt
CBT_DB_USER=cbt_user
CBT_DB_PASS=your_password_here

# Base URL where the CBT application is mounted (relative to web root)
CBT_BASE_URL=/simaks/cbt
