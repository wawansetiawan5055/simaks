<script>
$(document).ready(function() {
    let soalIndex = 0;

    // AJAX: Load CP based on Mapel & Tingkat
    function loadCP() {
        const idMapel = $('#id_mapel').val();
        const tingkat = $('#tingkat').val();
        if (!idMapel) return;

        $.getJSON(`index.php?mod=lms&act=get_cp_ajax&id_mapel=${idMapel}&tingkat=${tingkat}`, function(data) {
            const select = $('#id_cp');
            select.html('<option value="">-- Pilih CP --</option>');
            data.forEach(cp => {
                select.append(`<option value="${cp.id_cp}">${cp.deskripsi_cp.substring(0, 100)}...</option>`);
            });
        });
    }

    $('#id_mapel, #tingkat').change(loadCP);

    // AJAX: Load TP based on CP
    $('#id_cp').change(function() {
        const idCp = $(this).val();
        const container = $('#tp_container');
        if (!idCp) {
            container.html('<p class="text-muted small mb-0">Silakan pilih CP terlebih dahulu.</p>');
            return;
        }

        $.getJSON(`index.php?mod=lms&act=get_tp_ajax&id_cp=${idCp}`, function(data) {
            container.empty();
            if (data.length === 0) {
                container.append('<p class="text-muted small mb-0">Tidak ada TP untuk CP ini.</p>');
            } else {
                data.forEach(tp => {
                    container.append(`
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox" name="id_tp[]" value="${tp.id_tp}" class="custom-control-input" id="tp_${tp.id_tp}">
                            <label class="custom-control-label small font-weight-normal" for="tp_${tp.id_tp}">
                                <strong>${tp.kode_tp}</strong>: ${tp.deskripsi_tp}
                            </label>
                        </div>
                    `);
                });
            }
        });
    });

    // Handle Add Question
    $('#btnAddSoal').click(function() {
        const html = `
            <div class="soal-item card mb-4 border shadow-sm" id="soal_${soalIndex}">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <span class="font-weight-bold text-primary small">BUTIR SOAL #${soalIndex + 1}</span>
                    <button type="button" class="btn btn-sm text-danger" onclick="removeSoal(${soalIndex})"><i class="fas fa-trash"></i></button>
                </div>
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="small font-weight-bold">KATEGORI SOAL</label>
                            <select name="questions[${soalIndex}][kategori_soal]" class="form-control form-control-sm">
                                <option value="Latihan">Latihan Soal (Evaluasi Akhir)</option>
                                <option value="Diagnostik">Tes Diagnostik (Awal Pembelajaran)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="small font-weight-bold">TIPE</label>
                            <select name="questions[${soalIndex}][tipe]" class="form-control form-control-sm" onchange="toggleTipeSoal(${soalIndex}, this.value)">
                                <option value="PG">Pilihan Ganda</option>
                                <option value="Essay">Essay Singkat</option>
                            </select>
                        </div>
                    </div>
                    
                    <textarea name="questions[${soalIndex}][pertanyaan]" class="form-control form-control-sm mb-3" placeholder="Tuliskan pertanyaan di sini..." rows="2" required></textarea>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="small text-muted mb-1">Media Soal (Opsional)</label>
                            <input type="file" name="questions_media[${soalIndex}][file_pertanyaan]" class="form-control-file form-control-sm" accept="image/*,audio/*">
                        </div>
                    </div>

                    <div id="options_${soalIndex}">
                        ${['a','b','c','d','e'].map(opt => `
                            <div class="row no-gutters mb-2 align-items-center">
                                <div class="col-1 text-center font-weight-bold">${opt.toUpperCase()}</div>
                                <div class="col-7">
                                    <input type="text" name="questions[${soalIndex}][opsi_${opt}]" class="form-control form-control-sm" placeholder="Teks Opsi">
                                </div>
                                <div class="col-4 pl-2">
                                    <input type="file" name="questions_media[${soalIndex}][file_${opt}]" class="form-control-file form-control-sm" accept="image/*">
                                </div>
                            </div>
                        `).join('')}
                        <div class="mt-3">
                            <label class="small font-weight-bold">KUNCI JAWABAN</label>
                            <select name="questions[${soalIndex}][kunci_jawaban]" class="form-control form-control-sm">
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>`;
        $('#soalContainer').append(html);
        soalIndex++;
    });

    window.toggleTipeSoal = (idx, val) => $('#options_' + idx).toggle(val === 'PG');
    window.removeSoal = (idx) => $('#soal_' + idx).remove();
});
</script>

